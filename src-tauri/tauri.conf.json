{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinHub",
  "version": "0.1.0",
  "identifier": "net.aurix.linhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "LinHub",
      "width": 1440,
      "height": 960,
      "minWidth": 920,
      "minHeight": 640,
      "center": true,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"]
  }
}
